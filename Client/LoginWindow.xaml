<Window x:Class="Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Windows Live Messenger" Height="530" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F1F5F9" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <!-- ComboBox Item Template for Status -->
        <DataTemplate x:Key="StatusTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <!-- Wave Background Graphic -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E0F2FE" Offset="0.0"/>
                <GradientStop Color="#F1F5F9" Offset="0.4"/>
                <GradientStop Color="#BAE6FD" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Margin="30,20,30,20" VerticalAlignment="Center">
            <!-- WLM Animated Logo Header -->
            <Grid Width="96" Height="96" Margin="0,0,0,15" HorizontalAlignment="Center">
                <Grid x:Name="LogoContainer" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="LogoRotation" Angle="0"/>
                    </Grid.RenderTransform>
                    <!-- Nostalgic Buddies vector representation -->
                    <Canvas Width="96" Height="96">
                        <!-- Blue Buddy -->
                        <Ellipse Canvas.Left="20" Canvas.Top="20" Width="36" Height="36" Fill="#00A2ED"/>
                        <Path Data="M 2,75 C 2,55 35,50 35,50 C 35,50 68,55 68,75 L 68,90 L 2,90 Z" Fill="#0078D7"/>
                        <!-- Green Buddy -->
                        <Ellipse Canvas.Left="50" Canvas.Top="35" Width="28" Height="28" Fill="#8CC63F"/>
                        <Path Data="M 32,80 C 32,65 58,60 58,60 C 58,60 84,65 84,80 L 84,90 L 32,90 Z" Fill="#60B034"/>
                        <!-- Orange Butterfly center accent -->
                        <Path Data="M48,22 C43,15 52,10 54,18 Z" Fill="#FFB900"/>
                    </Canvas>
                </Grid>
            </Grid>

            <TextBlock Text="Windows Live Messenger" FontSize="20" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Sign in to your account" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <!-- Email Field -->
            <Label Content="Sign-in address (Email):" FontSize="11" Foreground="#475569" Margin="0,0,0,-3" Padding="0,5"/>
            <TextBox x:Name="TxtEmail" Height="32" Padding="8,5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="13" Margin="0,0,0,12">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Password Field -->
            <Label Content="Password:" FontSize="11" Foreground="#475569" Margin="0,0,0,-3" Padding="0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="32" Padding="8,5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="13" Margin="0,0,0,12">
                <!-- WPF does not allow direct styling of border corner radius on password box easily, standard is fine -->
            </PasswordBox>

            <!-- Sign in Status Selection -->
            <Label Content="Sign in as:" FontSize="11" Foreground="#475569" Margin="0,0,0,-3" Padding="0,5"/>
            <ComboBox x:Name="CmbStatus" Height="32" ItemTemplate="{StaticResource StatusTemplate}" SelectedIndex="0" Margin="0,0,0,15">
                <ComboBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </ComboBox.Resources>
            </ComboBox>

            <!-- Settings Checkboxes -->
            <CheckBox x:Name="ChkRememberMe" Content="Remember my ID" Margin="0,0,0,6" FontSize="12" Foreground="#334155"/>
            <CheckBox x:Name="ChkRememberPassword" Content="Remember my password" Margin="0,0,0,6" Checked="ChkRememberPassword_Checked" Unchecked="ChkRememberPassword_Unchecked" FontSize="12" Foreground="#334155"/>
            <CheckBox x:Name="ChkAutoLogin" Content="Sign me in automatically" Margin="0,0,0,15" Checked="ChkAutoLogin_Checked" FontSize="12" Foreground="#334155"/>

            <!-- Error Label -->
            <TextBlock x:Name="LblError" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

            <!-- Login Button -->
            <Button x:Name="BtnSignIn" Content="Sign In" Height="38" Background="#0284C7" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="BtnSignIn_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Registration links -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                <TextBlock FontSize="12" Foreground="#64748B" Text="Don't have an ID? "/>
                <TextBlock FontSize="12">
                    <Hyperlink Cursor="Hand" Click="Hyperlink_Register_Click" Foreground="#0284C7" TextDecorations="None">
                        Sign up
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <TextBlock FontSize="12" Foreground="#64748B" Text="Want to set your avatar? "/>
                <TextBlock FontSize="12">
                    <Hyperlink Cursor="Hand" Click="Hyperlink_Upload_Click" Foreground="#0284C7" TextDecorations="None">
                        Upload here
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
